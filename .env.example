# SigInsight local development environment overrides
#
# Copy this file to `.env` and adjust values as needed.
# `.env` is gitignored and loaded by `make go-run-community` via shell source.
# Any SIGINSIGHT_* variable set here overrides the Go binary defaults.

# --- Telemetry Store (ClickHouse) ---
# Your ClickHouse DSN. Change this if ClickHouse runs in a container
# with a different IP, e.g. tcp://172.15.0.3:9000
SIGINSIGHT_TELEMETRYSTORE_CLICKHOUSE_DSN=tcp://127.0.0.1:9000
SIGINSIGHT_TELEMETRYSTORE_CLICKHOUSE_CLUSTER=cluster
SIGINSIGHT_TELEMETRYSTORE_PROVIDER=clickhouse

# --- SQL Store ---
SIGINSIGHT_SQLSTORE_SQLITE_PATH=siginsight.db

# --- Web ---
# Set to true to serve embedded frontend on :8080 (requires `make js-build` first)
SIGINSIGHT_WEB_ENABLED=false

# --- Auth ---
SIGINSIGHT_TOKENIZER_JWT_SECRET=secret

# --- Alertmanager ---
SIGINSIGHT_ALERTMANAGER_PROVIDER=siginsight

# --- Instrumentation ---
SIGINSIGHT_INSTRUMENTATION_LOGS_LEVEL=debug
