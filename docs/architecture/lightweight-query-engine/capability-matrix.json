{
  "version": 5,
  "endpoint": "/api/v5/query_range",
  "resultTypes": ["raw", "trace", "time_series", "scalar"],
  "queryTypes": {
    "builder_query": "supported_subset",
    "builder_formula": "arithmetic_only",
    "builder_join": "rejected",
    "builder_sub_query": "rejected",
    "clickhouse_sql": "rejected"
  },
  "common": {
    "composition": {
      "rawAndTrace": "single_builder_query_without_formula",
      "timeSeriesAndScalar": "multiple_builder_queries_with_arithmetic_formulas"
    },
    "filterOperators": [
      "eq",
      "neq",
      "gt",
      "gte",
      "lt",
      "lte",
      "in",
      "not_in",
      "exists",
      "not_exists",
      "contains",
      "not_contains",
      "like",
      "not_like",
      "ilike",
      "not_ilike",
      "regexp",
      "not_regexp"
    ],
    "booleanOperators": ["and", "or"],
    "filterExpressionShape": "one_flat_and_or_chain",
    "groupBy": true,
    "order": "global_only",
    "limit": {
      "raw": "page_size",
      "trace": "page_size",
      "scalar": "result_cap",
      "time_series": "rejected_until_top_series_plan"
    },
    "pagination": {
      "offset": ["raw", "trace"],
      "opaqueCursor": false,
      "typedCursor": "live_logs_only",
      "pageInfo": ["raw", "trace"],
      "overflowProbe": "limit_plus_one_without_warning"
    },
    "resultTruncationWarning": "result_limit_reached_for_non_pageable_result_caps_only",
    "having": false,
    "internalAggregationPredicate": "single_typed_numeric_predicate",
    "functions": [],
    "formatOptions": ["fillGaps"],
    "stringPatternLimitBytes": 1024
  },
  "traceFunnel": {
    "filterSubset": "single_span_predicates_per_step",
    "supported": ["span_fields", "resource_attributes", "span_attributes", "string_patterns", "error_status"],
    "rejected": ["step_sequencing", "cross_span_join", "ancestor_descendant", "latency_pointer", "funnel_planner"]
  },
  "signals": {
    "logs": {
      "results": ["raw", "time_series", "scalar"],
      "filters": ["body_string", "body_json_path", "severity", "resource", "attribute"],
      "aggregations": ["count", "sum", "avg", "min", "max"],
      "baselineTests": [
        "tests/integration/src/compat/02_litequery_v5_bridge.py",
        "tests/integration/src/compat/03_litequery_collector_collaboration.py",
        "pkg/litequery/compiler_test.go"
      ]
    },
    "traces": {
      "results": ["raw", "trace", "time_series", "scalar"],
      "filters": ["service", "operation", "status", "duration", "resource", "span_attribute"],
      "aggregations": ["count", "duration_avg", "duration_p50", "duration_p90", "duration_p95", "duration_p99"],
      "baselineTests": [
        "tests/integration/src/compat/02_litequery_v5_bridge.py",
        "tests/integration/src/compat/03_litequery_collector_collaboration.py",
        "pkg/litequery/compiler_test.go"
      ]
    },
    "metrics": {
      "results": ["time_series", "scalar"],
      "types": {
        "gauge": ["latest", "avg", "min", "max"],
        "sum": ["sum", "rate", "increase"],
        "histogram": ["p50", "p90", "p95", "p99"]
      },
      "baselineTests": [
        "tests/integration/src/compat/02_litequery_v5_bridge.py",
        "tests/integration/src/compat/03_litequery_collector_collaboration.py",
        "pkg/litequery/compiler_test.go",
        "pkg/litequery/compiler_clickhouse_integration_test.go"
      ]
    },
    "meter": {
      "results": ["time_series", "scalar"],
      "aggregations": ["count", "sum", "avg", "rate", "increase"],
      "baselineTests": [
        "tests/integration/src/compat/02_litequery_v5_bridge.py",
        "tests/integration/src/compat/03_litequery_collector_collaboration.py",
        "pkg/litequery/compiler_clickhouse_integration_test.go"
      ]
    }
  },
  "alerts": {
    "formulaOperators": ["+", "-", "*", "/"],
    "reduceOperators": ["last", "avg", "min", "max", "sum"],
    "baselineTests": [
      "tests/integration/src/alerts/02_lightweight_threshold.py",
      "pkg/alertmanager/alertmanagerstore/sqlalertmanagerstore/config_test.go",
      "pkg/query-service/rules/threshold_rule_test.go"
    ]
  }
}
